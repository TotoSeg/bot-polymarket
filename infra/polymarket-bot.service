[Unit]
Description=Polymarket Bot S3+SP — Trading automatique NO sur marchés bias
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bot-polymarket
ExecStart=/home/ubuntu/bot-polymarket/.venv/bin/python src/phase6_bot/live_bot.py --loop
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polymarket-bot
EnvironmentFile=/home/ubuntu/bot-polymarket/src/phase6_bot/.env

[Install]
WantedBy=multi-user.target
