# Copier ce fichier en .env et remplir les valeurs RÉELLES
# .env est dans .gitignore — ne JAMAIS committer les vraies clés

# Wallet Ethereum (Polygon) — clé privée du compte de trading
# Générer avec : python -c "from eth_account import Account; a=Account.create(); print(a.key.hex())"
POLYMARKET_PRIVATE_KEY=0x_VOTRE_CLE_PRIVEE_ICI

# Clés API Polymarket CLOB (niveau 2 — signature)
# Générer avec : python src/phase6_bot/live_bot.py --create-keys
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Capital de départ en USDC (à déposer sur le wallet)
INITIAL_CAPITAL_USDC=500

# Stratégie active : S3 (seule validée par le backtest)
ACTIVE_STRATEGY=S3

# Mise maximale par trade en USDC (recommandé : 2-5% du capital)
MAX_BET_USDC=200

# Seuil de volume minimum des marchés à traiter
MIN_VOLUME_USD=500
