# Copier ce fichier en .env et remplir les valeurs RÉELLES
# .env est dans .gitignore – ne JAMAIS committer les vraies clés

# Wallet Ethereum (Polygon) – clé privée du compte de trading
# Générer avec : python -c "from eth_account import Account; a=Account.create(); print(a.key.hex())"
POLYMARKET_PRIVATE_KEY=0x_VOTRE_CLE_PRIVEE_ICI

# Clés API Polymarket CLOB (niveau 2 – signature)
# Générer avec : python src/phase6_bot/live_bot.py --create-keys
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Adresse du wallet proxy Polymarket (⚠️  adresse MetaMask)
# Visible sur https://polymarket.com/wallet en haut de page
# Indispensable pour les dépôts pUSD (cas standard depuis 2024)
POLYMARKET_PROXY_WALLET=0x_ADRESSE_PROXY_ICI

# Capital de départ en USDC (à déposer sur le wallet)
INITIAL_CAPITAL_USDC=500

# Stratégie active : S3 (seule validée par le backtest)
ACTIVE_STRATEGY=S3

# Mise maximale par trade en USDC (recommandé : 2-5% du capital)
MAX_BET_USDC=200

# Seuil de volume minimum des marchés à traiter
MIN_VOLUME_USD=500

# ── Reporting Notion (optionnel) ─────────────────────────────────────────────
# Si absent ou vide, le reporting Notion est désactivé silencieusement.
#
# Étapes de configuration :
#   1. Aller sur https://www.notion.so/my-integrations → "New integration"
#   2. Donner un nom (ex: "Polymarket Bot"), choisir le workspace
#   3. Copier le "Internal Integration Token" (commence par secret_...)
#   4. Créer une base de données Notion avec ces colonnes :
#        Titre (Title), Taille $ (Number), Gain espéré $ (Number),
#        Résolution (Date), Stratégie (Select), YES entrée (Number), market_id (Rich text)
#   5. Ouvrir la base, cliquer "..." → "Add connections" → sélectionner l'intégration
#   6. Copier l'ID de la base depuis l'URL : notion.so/xxx/<DATABASE_ID>?v=...
#   7. Dans la vue Notion, configurer le tri par "Résolution" ascendant (une seule fois)
#
NOTION_TOKEN=secret_VOTRE_TOKEN_ICI
NOTION_DATABASE_ID=VOTRE_DATABASE_ID_ICI
